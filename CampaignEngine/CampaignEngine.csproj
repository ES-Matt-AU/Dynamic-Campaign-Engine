<Project Sdk="Microsoft.NET.Sdk">

  <!--
    netstandard2.0 so the same library can later be loaded by a VTOL VR mod
    (Unity 2020.3 / .NET Framework 4.x). Newtonsoft.Json 13 is already shipped with the game.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>CampaignEngine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

</Project>
